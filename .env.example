# Kisan Vyapar — environment configuration.
#
# Copy this file to `.env.local` and fill in real values locally.
# NEVER commit real credentials, connection strings, or API keys.
#
# Only variables required by currently implemented functionality are listed.
# Variables for planned integrations (e.g. MANDI_API_URL, MAPS_API_KEY,
# AI_API_KEY, AUTH_SECRET) will be added when those systems are implemented.

# MongoDB connection string for the application database.
# Example shape (NOT a real credential): mongodb://localhost:27017/kisan-vyapar
MONGODB_URI=

# MongoDB database name (defaults to "kisan-vyapar" when empty).
DATABASE_NAME=kisan-vyapar

# Official market-data source (AGMARKNET 2.0). Leave EMPTY until the API
# contract is verified with a real response and access is obtained — the app
# reports prices as unavailable rather than using fake data.
#
# Verified facts (from the official Agmarknet 2.0 portal bundle):
#   API base      : https://api.agmarknet.gov.in/v1/
#   price reports : POST /daily-price-arrival/report  (Bearer-token protected)
#   masters       : /commodities, /location/state, /market, /grade, /variety, /units
# AGMARKNET has NO "resource id" concept (data.gov.in only) — it uses
# commodity_id/state_id/district_id/market_id identifiers from its masters.
MARKET_DATA_PROVIDER=agmarknet
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
