# Kisan Vyapar — environment configuration.
#
# Copy this file to `.env.local` and fill in real values locally.
# NEVER commit real credentials, connection strings, or API keys.
#
# Only variables required by currently implemented functionality are listed.
# Variables for planned integrations (e.g. MANDI_API_URL, MAPS_API_KEY,
# AI_API_KEY, AUTH_SECRET) will be added when those systems are implemented.

# MongoDB connection string for the application database.
# Example shape (NOT a real credential): mongodb://localhost:27017/kisan-vyapar
MONGODB_URI=

# MongoDB database name (defaults to "kisan-vyapar" when empty).
DATABASE_NAME=kisan-vyapar
