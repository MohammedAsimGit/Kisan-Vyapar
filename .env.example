# Kisan Vyapar — environment configuration.
#
# Copy this file to `.env.local` and fill in real values locally.
# NEVER commit real credentials, connection strings, or API keys.
#
# Only variables required by currently implemented functionality are listed.
# Variables for planned integrations (e.g. MANDI_API_URL, MAPS_API_KEY,
# AI_API_KEY, AUTH_SECRET) will be added when those systems are implemented.

# MongoDB connection string for the application database.
# Example shape (NOT a real credential): mongodb://localhost:27017/kisan-vyapar
MONGODB_URI=

# MongoDB database name (defaults to "kisan-vyapar" when empty).
DATABASE_NAME=kisan-vyapar

# Official market-data source (data.gov.in — Government of India Open Data).
# The dataset used is "Current Daily Price of Various Commodities from Various
# Markets (Mandi)" (AGMARKNET mandi data published on data.gov.in).
#
# Resource request shape (server-side only):
#   {BASE_URL}/resource/{RESOURCE_ID}?api-key={API_KEY}&format=json
#
# These values are optional only for running the rest of the app. If they are
# incomplete, the market-price feature reports prices as unavailable — it never
# invents or fabricates market prices.
MARKET_DATA_PROVIDER=data.gov.in
MARKET_DATA_BASE_URL=https://api.data.gov.in
MARKET_DATA_API_KEY=
MARKET_DATA_RESOURCE_ID=

# Optional cost model used only to estimate the net price a farmer would take
# home (Modal price - costs). Leave empty to rank by modal price alone.
# Amounts are per quintal (INR); commission is a percentage of the modal price.
MARKET_COST_TRANSPORT_PER_QTL=
MARKET_COST_OTHER_PER_QTL=
MARKET_COST_COMMISSION_PERCENT=
